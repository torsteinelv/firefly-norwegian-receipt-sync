# Firefly III
FIREFLY_INSTANCE_URL=http://din_firefly_ip:8080
FIREFLY_PAT=ditt_personal_access_token_her
FIREFLY_ASSET_ACCOUNT="Navnet på bankkontoen din i Firefly"

# Trumf (Kiwi/Meny/Spar)
TRUMF_TOKEN="din_trumf_cookie_token_her"

# Rema 1000 (Æ) - hent med: python bootstrap_oauth.py rema
REMA_REFRESH_TOKEN=""
# Valgfri - default er den offentlig kjente verdien fra Android-APK-en, se
# rema.py sin kommentar. Sett kun om Rema endrer den og du finner den nye.
# REMA_SUBSCRIPTION_KEY=""

# Coop (Extra/Obs/Mega/Prix) - hent med: python bootstrap_oauth.py coop
# COOP_CLIENT_ID må finnes manuelt (proxy Coop Medlem-appens trafikk én
# gang, f.eks. med mitmproxy) - ikke i det reverse-engineerte
# kildematerialet dette er bygget fra.
COOP_CLIENT_ID=""
COOP_REFRESH_TOKEN=""
